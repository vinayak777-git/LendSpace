# Server Configuration
PROJECT_NAME="LendSpace API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"

# Database Configuration (Single Local Database or Docker PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./lendspace.db"
# Or Docker PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/<db_name>"

# Security & Authentication (Argon2id + JWT)
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage & Uploads
STORAGE_DIR="./uploads"
UPLOAD_DIR="./uploads"
OUTBOX_DIR="./outbox"
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB

# Background Job Scheduler & Notifications
ENABLE_BACKGROUND_JOBS=true
# Optional SMTP (leave blank for local file outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
